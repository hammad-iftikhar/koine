# Copy to .env — docker compose reads it automatically. .env is gitignored.

DATABASE_URL=postgres://koine:koine@localhost:5432/koine
# redis.ts throws at import when this is unset — needed to work on the apps
# from the host, not just inside the app containers.
REDIS_URL=redis://localhost:6379
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret_change_me_at_least_32_chars
# The browser-reachable LiveKit URL, returned to clients in the join response.
LIVEKIT_PUBLIC_URL=ws://localhost:7880
BETTER_AUTH_SECRET=dev_auth_secret_change_me_at_least_32ch
# The API's own public URL. Google's redirect_uri is derived from it, so it has
# to match the one registered in the Google Cloud console.
BETTER_AUTH_URL=http://localhost:3000
GUEST_TOKEN_SECRET=dev_guest_secret_change_me_at_least_32c
WEB_ORIGIN=http://localhost:5173,http://localhost:4173

# Real credentials. Sign-in and translation stay unavailable until these are set;
# everything else runs without them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
# Model names were not fixed by the Task 1 latency spike (no API key, no real
# speech fixtures were available), so they are set here instead of hardcoded.
# See docs/superpowers/specs/2026-09-18-koine/06-translation.md.
OPENAI_STT_MODEL=gpt-transcribe
OPENAI_TRANSLATE_MODEL=gpt-5.6-luna
OPENAI_TTS_MODEL=gpt-4o-mini-tts
